レトロなcss

/* 全体背景 */
body {
  background: #1a1a1a;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
}

/* ラジカセ本体 */
.boombox {
  width: 600px;
  background: linear-gradient(145deg, #2a2a2a, #1a1a1a);
  border-radius: 20px;
  padding: 24px;
  border: 2px solid #444;
  box-shadow:
    0 0 0 1px #555,
    8px 8px 20px rgba(0, 0, 0, 0.8),
    inset 0 1px 0 rgba(255, 255, 255, 0.05);
}

/* カセット窓 */
.caset {
  background: #111;
  border-radius: 12px;
  height: 160px;
  margin-bottom: 16px;
  border: 2px solid #333;
  box-shadow: inset 0 4px 12px rgba(0, 0, 0, 0.8);
  display: flex;
  justify-content: space-around;
  align-items: center;
}


/* 曲名・情報表示エリア */
.music {
  background: #0d0d0d;
  border-radius: 8px;
  height: 48px;
  margin-bottom: 16px;
  border: 1px solid #333;
  box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  padding: 0 12px;
  font-family: "Courier New", monospace;
  color: #c8a96e;
  font-size: 14px;
  letter-spacing: 2px;
}

/* ボタンエリア */
.button {
  display: flex;
  justify-content: center;
  gap: 16px;
  padding: 8px 0;
}

/* リール */
.reel {
  width: 100px;
  height: 100px;
  border-radius: 50%;
  background: radial-gradient(
    circle at center,
    #2a2a2a 28%,
    #444 30%,
    #1a1a1a 32%,
    #333 60%,
    #222 62%
  );
  border: 4px solid #555;
  box-shadow:
    0 0 0 2px #222,
    inset 0 0 8px rgba(0, 0, 0, 0.8);
}

/* リール回転アニメーション */
@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.reel.playing {
  animation: spin 3s linear infinite;
}

.reel.playing {
  border-top: 4px solid #888;
  border-right: 4px solid #555;
  border-bottom: 4px solid #333;
  border-left: 4px solid #555;
}
/* 曲名スクロールアニメーション */
@keyframes marquee {
  0% {
    transform: translateX(500px);
  }
  100% {
    transform: translateX(-500px);
  }
}
.music {
  overflow: hidden;
}

.music p {
  margin: 0;
  white-space: nowrap;
  animation: marquee 8s linear infinite;
  display: inline-block; 
}

/* コンテンツエリア */
.content {
  width: 600px;
  margin: 16px auto 0;
  padding: 20px 24px;
  background: #1a1a1a;
  border: 1px solid #333;
  border-radius: 12px;
  color: #c8a96e;
  font-family: "Courier New", monospace;
}

.content p {
  margin: 0 0 8px;
  font-size: 14px;
  line-height: 1.6;
  color: #aaa;
}

.content p:first-child {
  font-size: 18px;
  font-weight: bold;
  color: #c8a96e;
  margin-bottom: 12px;
}

.content a {
  display: inline-block;
  margin-top: 8px;
  padding: 6px 14px;
  border: 1px solid #c8a96e;
  border-radius: 4px;
  color: #c8a96e;
  text-decoration: none;
  font-size: 13px;
  letter-spacing: 1px;
}

.content a:hover {
  background: #c8a96e;
  color: #1a1a1a;
}

/* ボタン共通 */
.button button {
  width: 48px;
  height: 48px;
  border: none;
  border-radius: 50%;
  background: linear-gradient(145deg, #3a3a3a, #222);
  color: #c8a96e;
  font-size: 14px;
  cursor: pointer;
  box-shadow:
    3px 3px 6px rgba(0, 0, 0, 0.6),
    -1px -1px 3px rgba(255, 255, 255, 0.05);
  transition: all 0.1s ease;
}
 
.button button:hover {
  background: linear-gradient(145deg, #444, #2a2a2a);
  color: #e0c080;
}
 
.button button:active {
  box-shadow:
    inset 2px 2px 4px rgba(0, 0, 0, 0.6),
    inset -1px -1px 2px rgba(255, 255, 255, 0.05);
  transform: scale(0.96);
}
 
/* 再生・停止ボタンだけ少し大きく */
.button button:nth-child(2) {
  width: 60px;
  height: 60px;
  font-size: 18px;
  background: linear-gradient(145deg, #c8a96e, #a07840);
  color: #1a1a1a;
}
 
.button button:nth-child(2):hover {
  background: linear-gradient(145deg, #e0c080, #b08850);
}

.button button:focus {
  outline: none;
}